# Copy to .env and adjust. .env is git-ignored.

# Override the storage root for data/outputs (defaults to the project root).
# ROADMARKING_DATA_ROOT=D:/roadmarking-storage

# Select the CUDA device (e.g. "cuda:0" or "cpu"). Overrides configs/default.yaml.
# ROADMARKING_DEVICE=cuda:0

# Hugging Face cache location (model weights are downloaded here, not into git).
# HF_HOME=D:/hf-cache

# Hugging Face token, only if a gated/private checkpoint is ever needed. Never commit.
# HF_TOKEN=

# Allow the model smoke test to download pretrained weights (~280 MB).
# ROADMARKING_ALLOW_MODEL_DOWNLOAD=0
